<header class="site-nav">
  <a class="site-wordmark" href="/">
    <svg class="wordmark-icon" width="26" height="26" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M16 9C13.5 7 9 6.5 5 7.5V23.5C9 22.5 13.5 23 16 25C18.5 23 23 22.5 27 23.5V7.5C23 6.5 18.5 7 16 9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M16 9V25" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="25" cy="5" r="1.5" fill="currentColor"/>
    </svg>
    <span>The Warm Corner</span>
  </a>

  <nav class="site-nav-links">
    <% if (user) { %>
      <a href="/">Home</a>
      <% if (user.role === 'admin') { %>
        <a href="/admin">Admin</a>
      <% } %>
      <form method="POST" action="/logout" class="inline-form">
        <button type="submit" class="link-button">Log Out</button>
      </form>
    <% } %>

    <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Switch between light and dark mode">
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5"/>
        <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"/>
      </svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 1 0 10.5 10.5Z"/>
      </svg>
    </button>
  </nav>
</header>
