<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <%- include('partials/theme-init') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Warm Corner</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav') %>

  <main class="page">
    <h1>Bonus Chapters</h1>
    <p class="page-intro">Welcome back, <%= user.username %>.</p>

    <% if (chapters.length === 0) { %>
      <p class="empty-state">No chapters have been posted yet — check back soon.</p>
    <% } else { %>
      <ul class="chapter-list">
        <% chapters.forEach(function(chapter) { %>
          <li class="chapter-card">
            <a class="chapter-title" href="/chapters/<%= chapter.id %>"><%= chapter.title %></a>
            <div class="chapter-meta">
              <span>Posted <%= chapter.created_at.toDateString() %></span>
              <span><%= chapter.vote_count %> vote<%= chapter.vote_count == 1 ? '' : 's' %></span>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </main>

  <script src="/js/theme-toggle.js"></script>
</body>
</html>
